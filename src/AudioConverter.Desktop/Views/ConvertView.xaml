<UserControl x:Class="AudioConverter.Desktop.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AudioConverter.Desktop.Localization"
             xmlns:controls="clr-namespace:AudioConverter.Desktop.Controls">
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Convert}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T ChangeTheFormatAndQualityOf}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Source}" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding HasQueue, Converter={StaticResource InverseBooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="{l:T DropAudioFilesOrFoldersHere}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T FoldersAddTheirFilesWithoutSubfolders}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="{l:T ChooseFiles}" Command="{Binding ChooseFileCommand}" Margin="0,0,8,0" /><Button Content="{l:T ChooseFolder}" Command="{Binding ChooseFolderCommand}" /></StackPanel>
                    </StackPanel>
                </ContentControl>
                <StackPanel Visibility="{Binding HasQueue, Converter={StaticResource BooleanToVisibility}}">
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{l:T AddFiles}" Command="{Binding ChooseFileCommand}" Margin="0,0,8,0" /><Button Content="{l:T AddFolder}" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0" /><Button Content="{l:T Clear}" Command="{Binding ClearQueueCommand}" /></StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding QueueSummary}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Queue}" Style="{StaticResource QueueList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource QueueRow}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FileGlyph}" FontSize="16" Text="{StaticResource GlyphAudio}" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding Name}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding Folder}" /></StackPanel>
                                        <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource QueueStatus}" Focusable="False" Margin="12,0" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="{StaticResource GlyphRemove}" ToolTip="{l:T RemoveFromTheQueue}" AutomationProperties.Name="{l:T RemoveFromTheQueue}" Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T OutputFormat}" />
                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" ItemTemplate="{StaticResource FormatItem}" AutomationProperties.Name="{l:T OutputFormat}" />
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Visibility="{Binding IsLossyFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{l:T AudioQuality}" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate}" /></StackPanel>
                    <StackPanel Visibility="{Binding IsLosslessFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{l:T SampleRate}" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" /></StackPanel>
                    <StackPanel Grid.Column="2" Visibility="{Binding IsLosslessFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{l:T BitDepth}" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding BitDepth}" /></StackPanel>
                </Grid>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Destination}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T OutputFolder}" Margin="0,0,0,7" /><TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Grid.Column="1" Content="{l:T Browse}" Command="{Binding ChooseOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,16,0" />
                    <StackPanel Grid.Column="2"><TextBlock Text="{l:T FileSuffixOptional}" Margin="0,0,0,7" /><TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T LeaveBlankToCreateAConverted}" Margin="2,8,0,14" />
                <WrapPanel><CheckBox Content="{l:T KeepTitleArtistAlbumAndCover}" IsChecked="{Binding PreserveMetadata}" Margin="0,4,28,4" /><CheckBox Content="{l:T OverwriteExistingFiles}" IsChecked="{Binding Overwrite}" /></WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T TagsAndEmbeddedCoverArtAre}" Margin="2,6,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{l:T SaveReport}" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Report}" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>