<Window x:Class="AudioConverter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AudioConverter.Desktop.Controls"
        xmlns:converters="clr-namespace:AudioConverter.Desktop.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d" Title="CodecTone" Width="1180" Height="820" MinWidth="900" MinHeight="650"
        Icon="Assets/audio-converter-logo.png" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:TimestampValueConverter x:Key="TimestampConverter" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        <converters:PathPartConverter x:Key="PathPart" />
        <converters:UpperCaseConverter x:Key="UpperCase" />
        <DataTemplate x:Key="FormatItem"><TextBlock Text="{Binding Converter={StaticResource UpperCase}}" /></DataTemplate>
        <Style x:Key="HiddenWhenBusy" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="FileName" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
        <Style x:Key="FilePath" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Margin" Value="0,3,0,0" /></Style>
        <Style x:Key="FileGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="FontSize" Value="22" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Margin" Value="2,0,16,0" /></Style>
        <Style x:Key="DropGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="FontSize" Value="26" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Text" Value="{StaticResource GlyphDrop}" /></Style>
        <Style x:Key="DropTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Margin" Value="0,10,0,4" /></Style>
        <Style x:Key="Rule" TargetType="Separator"><Setter Property="Background" Value="{DynamicResource BorderBrush}" /><Setter Property="Margin" Value="0,22" /></Style>
        <converters:ReportLinesConverter x:Key="ReportLines" />
        <x:Array x:Key="InspectorTabs" Type="sys:String"><sys:String>Export</sys:String><sys:String>Metadata</sys:String></x:Array>
        <!-- Reports render as status rows; the raw text stays one click away and is what Save report writes. -->
        <DataTemplate x:Key="ReportView">
            <StackPanel>
                <Border Style="{StaticResource InfoBox}" Padding="4">
                    <ItemsControl ItemsSource="{Binding Converter={StaticResource ReportLines}}" MaxHeight="280" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" Focusable="False">
                        <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False"><ItemsPresenter /></ScrollViewer></ControlTemplate></ItemsControl.Template>
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5" ToolTip="{Binding Raw}"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock x:Name="Line" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Ok"><Setter TargetName="Glyph" Property="Text" Value="{StaticResource GlyphCheck}" /><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Fail"><Setter TargetName="Glyph" Property="Text" Value="{StaticResource GlyphRemove}" /><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Skip"><Setter TargetName="Glyph" Property="Text" Value="{StaticResource GlyphSkip}" /><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter TargetName="Line" Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Cancelled"><Setter TargetName="Glyph" Property="Text" Value="{StaticResource GlyphStop}" /><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter TargetName="Line" Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Expander Style="{StaticResource Disclosure}" Header="Raw report" Margin="2,10,0,0">
                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="300" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" />
                </Expander>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Padding" Value="14,8" /></Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BackdropBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,20,12,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Image Source="Assets/audio-converter-logo.png" Width="28" Height="28" />
                    <TextBlock Text="CodecTone" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowAboutCommand}" AutomationProperties.Name="About" Tag="{Binding AboutTabState}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphAbout}" Width="28" /><TextBlock Text="About" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="{Binding ThemeButtonText}" AutomationProperties.HelpText="{Binding ThemeButtonToolTip}" ToolTip="{Binding ThemeButtonToolTip}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphTheme}" Width="28" /><TextBlock Text="{Binding ThemeButtonText}" /></StackPanel></Button>
                    <StackPanel Orientation="Horizontal" Margin="10,14,0,0" ToolTip="Media never leaves this computer.">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphLock}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Width="28" />
                        <TextBlock Style="{StaticResource Caption}" Text="Local · no telemetry" />
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowConvertCommand}" AutomationProperties.Name="Convert" Tag="{Binding ConvertTabState}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphConvert}" Width="28" /><TextBlock Text="Convert" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowCutCommand}" AutomationProperties.Name="Cut" Tag="{Binding CutTabState}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphCut}" Width="28" /><TextBlock Text="Cut" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowCompressCommand}" AutomationProperties.Name="Compress" Tag="{Binding CompressionTabState}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphCompress}" Width="28" /><TextBlock Text="Compress" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowArtworkCommand}" AutomationProperties.Name="Artwork" Tag="{Binding ArtworkTabState}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphArtwork}" Width="28" /><TextBlock Text="Artwork" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowRemixCommand}" AutomationProperties.Name="Remix" Tag="{Binding RemixTabState}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphRemix}" Width="28" /><TextBlock Text="Remix" /></StackPanel></Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer IsEnabled="{Binding IsWorkspaceEnabled}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <Grid Margin="32,26,32,28">

                    <StackPanel Style="{StaticResource PageHost}" Visibility="{Binding IsConvertPage, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Convert" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Change the format and quality of one file, or of every file in a folder." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Source" />
                                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DropGlyph}" />
                                        <TextBlock Style="{StaticResource DropTitle}" Text="Drop an audio file or a folder here" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Folders are converted without their subfolders." HorizontalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="Choose file" Command="{Binding ChooseFileCommand}" Margin="0,0,8,0" /><Button Content="Choose folder" Command="{Binding ChooseFolderCommand}" /></StackPanel>
                                    </StackPanel>
                                </ContentControl>
                                <Border Style="{StaticResource FileCard}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FileGlyph}" Text="{Binding SourcePath, Converter={StaticResource PathPart}, ConverterParameter=Glyph}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding SourcePath, Converter={StaticResource PathPart}, ConverterParameter=Parent}" /></StackPanel>
                                        <Button Grid.Column="2" Content="Change file" Command="{Binding ChooseFileCommand}" Margin="12,0,8,0" />
                                        <Button Grid.Column="3" Content="Change folder" Command="{Binding ChooseFolderCommand}" />
                                    </Grid>
                                </Border>
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Output format" />
                                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" ItemTemplate="{StaticResource FormatItem}" AutomationProperties.Name="Output format" />
                                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Visibility="{Binding IsLossyFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Audio quality" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate}" /></StackPanel>
                                    <StackPanel Visibility="{Binding IsLosslessFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Sample rate" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" /></StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="{Binding IsLosslessFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Bit depth" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding BitDepth}" /></StackPanel>
                                </Grid>
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Destination" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,16,0" />
                                    <StackPanel Grid.Column="2"><TextBlock Text="File suffix · optional" Margin="0,0,0,7" /><TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Text="Leave blank to create a 'converted' folder beside each source." Margin="2,8,0,14" />
                                <WrapPanel><CheckBox Content="Keep title, artist, album and cover art" IsChecked="{Binding PreserveMetadata}" Margin="0,4,28,4" /><CheckBox Content="Overwrite existing files" IsChecked="{Binding Overwrite}" /></WrapPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Tags and embedded cover art are copied when the destination supports them." Margin="2,6,0,0" />
                                <Separator Style="{StaticResource Rule}" />

                                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Save report" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="Report" Margin="0" VerticalAlignment="Center" /></DockPanel>
                                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Style="{StaticResource PageHost}" Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Cut" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Select part of a track, add fades, preview it, then export it." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Source" />
                                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding CutSourcePath, Converter={StaticResource EmptyToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DropGlyph}" />
                                        <TextBlock Style="{StaticResource DropTitle}" Text="Drop one audio file here" />
                                        <TextBlock Style="{StaticResource Caption}" Text="MP3, FLAC, WAV, OGG, AAC or M4A." HorizontalAlignment="Center" />
                                        <Button Content="Choose file" Command="{Binding ChooseCutFileCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    </StackPanel>
                                </ContentControl>
                                <Border Style="{StaticResource FileCard}" Visibility="{Binding CutSourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FileGlyph}" Text="{StaticResource GlyphAudio}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding CutSourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding CutSourceDetails}" /></StackPanel>
                                        <Button Grid.Column="2" Content="Change file" Command="{Binding ChooseCutFileCommand}" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Selection" />
                                <controls:WaveformControl Peaks="{Binding WaveformPeaks}" Duration="{Binding DurationSeconds}" Start="{Binding StartSeconds}" End="{Binding EndSeconds}" Playhead="{Binding CutPlayheadSeconds}" Height="240" AutomationProperties.Name="Cut selection waveform" />
                                <DockPanel Margin="0,10,0,16">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button Style="{StaticResource TransportButton}" Command="{Binding PreviewCommand}" AutomationProperties.Name="Preview cut"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphPlay}" FontSize="12" Margin="0,0,8,0" /><TextBlock Text="Preview cut" /></StackPanel></Button>
                                        <Button Style="{StaticResource TransportButton}" Command="{Binding StopPreviewCommand}" AutomationProperties.Name="Stop preview"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphStop}" FontSize="12" Margin="0,0,8,0" /><TextBlock Text="Stop" /></StackPanel></Button>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="Drag a handle, or focus the waveform and use the arrow keys (Shift for 1 s, [ and ] to pick a handle)." VerticalAlignment="Center" Margin="8,0,0,0" />
                                </DockPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Start" Margin="0,0,0,7" /><TextBox Text="{Binding StartSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="End" Margin="0,0,0,7" /><TextBox Text="{Binding EndSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Selection length" Margin="0,0,0,7" /><TextBlock Text="{Binding SelectionDuration, Converter={StaticResource TimestampConverter}}" FontSize="16" FontWeight="SemiBold" Padding="0,8" /></StackPanel>
                                </Grid>
                                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0"><CheckBox Content="Fade in" IsChecked="{Binding FadeInEnabled}" /><TextBox Text="{Binding FadeInSeconds}" Margin="0,6,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1"><CheckBox Content="Fade out" IsChecked="{Binding FadeOutEnabled}" /><TextBox Text="{Binding FadeOutSeconds}" Margin="0,6,0,0" /></StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Text="Fade duration in seconds." Margin="2,7,0,0" />
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Output format" />
                                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Formats}" SelectedItem="{Binding CutFormat}" ItemTemplate="{StaticResource FormatItem}" AutomationProperties.Name="Output format" />
                                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding CutOutputFolder}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseCutOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,16,0" />
                                    <StackPanel Grid.Column="2"><TextBlock Text="File suffix" Margin="0,0,0,7" /><TextBox Text="{Binding CutSuffix}" /></StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,14,0,0"><CheckBox Content="Keep metadata and cover art" IsChecked="{Binding PreserveMetadata}" Margin="0,4,28,4" /><CheckBox Content="Overwrite existing file" IsChecked="{Binding Overwrite}" /></WrapPanel>
                                <Separator Style="{StaticResource Rule}" />

                                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Save report" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="Report" Margin="0" VerticalAlignment="Center" /></DockPanel>
                                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Style="{StaticResource PageHost}" Visibility="{Binding IsCompressionPage, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Compress" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Reduce file size with a quality profile or a total size budget. Folders include their subfolders." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Source" />
                                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding CompressionSourcePath, Converter={StaticResource EmptyToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DropGlyph}" />
                                        <TextBlock Style="{StaticResource DropTitle}" Text="Drop an audio file or a folder here" />
                                        <TextBlock Style="{StaticResource Caption}" Text="The source is analyzed as soon as you choose it." HorizontalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="Choose file" Command="{Binding ChooseCompressionFileCommand}" Margin="0,0,8,0" /><Button Content="Choose folder" Command="{Binding ChooseCompressionFolderCommand}" /></StackPanel>
                                    </StackPanel>
                                </ContentControl>
                                <Border Style="{StaticResource FileCard}" Visibility="{Binding CompressionSourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FileGlyph}" Text="{Binding CompressionSourcePath, Converter={StaticResource PathPart}, ConverterParameter=Glyph}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding CompressionSourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding CompressionSourcePath, Converter={StaticResource PathPart}, ConverterParameter=Parent}" /></StackPanel>
                                        <Button Grid.Column="2" Content="Change file" Command="{Binding ChooseCompressionFileCommand}" Margin="12,0,8,0" />
                                        <Button Grid.Column="3" Content="Change folder" Command="{Binding ChooseCompressionFolderCommand}" />
                                    </Grid>
                                </Border>
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Compress to" />
                                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding CompressionFormats}" SelectedItem="{Binding CompressionFormat}" ItemTemplate="{StaticResource FormatItem}" AutomationProperties.Name="Compression format" />
                                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Compression profile" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding CompressionProfiles}" SelectedItem="{Binding SelectedCompressionProfile}" /></StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="{Binding IsTargetSizeCompression, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Target total size · MiB" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionTargetTotalMb}" /></StackPanel>
                                    <Button Grid.Column="3" Content="Analyze" Command="{Binding AnalyzeCompressionCommand}" VerticalAlignment="Bottom" Margin="14,0,0,0" />
                                </Grid>
                                <Border Style="{StaticResource InfoBox}" Margin="0,18,0,0"><TextBlock Text="{Binding CompressionEstimate}" TextWrapping="Wrap" /></Border>
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Destination" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionOutputFolder}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseCompressionOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,16,0" />
                                    <StackPanel Grid.Column="2"><TextBlock Text="File suffix · optional" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionSuffix}" /></StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Text="Leave blank to create a 'compressed' folder and keep the source tree." Margin="2,8,0,12" />
                                <WrapPanel>
                                    <CheckBox Content="Keep metadata and cover art" IsChecked="{Binding CompressionPreserveMetadata}" Margin="0,4,28,4" />
                                    <CheckBox Content="Shrink large cover art · max 1200 px" IsChecked="{Binding CompressionOptimizeArtwork}" Margin="0,4,28,4" />
                                    <CheckBox Content="Overwrite existing files" IsChecked="{Binding CompressionOverwrite}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Re-encoding lossy files asks for confirmation because it can reduce quality." Margin="2,6,0,0" />
                                <Separator Style="{StaticResource Rule}" />

                                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Save report" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="Report" Margin="0" VerticalAlignment="Center" /></DockPanel>
                                <ContentControl Content="{Binding CompressionReport}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Style="{StaticResource PageHost}" Visibility="{Binding IsArtworkPage, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Extract artwork" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Save one embedded front cover per album, as the original image or converted." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Source" />
                                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding ArtworkSourcePath, Converter={StaticResource EmptyToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DropGlyph}" />
                                        <TextBlock Style="{StaticResource DropTitle}" Text="Drop an audio file or a folder here" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Folders are scanned with their subfolders. One front cover is kept per album." HorizontalAlignment="Center" TextAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="Choose file" Command="{Binding ChooseArtworkFileCommand}" Margin="0,0,8,0" /><Button Content="Choose folder" Command="{Binding ChooseArtworkFolderCommand}" /></StackPanel>
                                    </StackPanel>
                                </ContentControl>
                                <Border Style="{StaticResource FileCard}" Visibility="{Binding ArtworkSourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FileGlyph}" Text="{Binding ArtworkSourcePath, Converter={StaticResource PathPart}, ConverterParameter=Glyph}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding ArtworkSourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding ArtworkSourcePath, Converter={StaticResource PathPart}, ConverterParameter=Parent}" /></StackPanel>
                                        <Button Grid.Column="2" Content="Change file" Command="{Binding ChooseArtworkFileCommand}" Margin="12,0,8,0" />
                                        <Button Grid.Column="3" Content="Change folder" Command="{Binding ChooseArtworkFolderCommand}" />
                                    </Grid>
                                </Border>
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Image format" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Save as" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding ArtworkOutputFormats}" SelectedItem="{Binding ArtworkOutputFormat}" /></StackPanel>
                                    <StackPanel Grid.Column="2" IsEnabled="{Binding IsArtworkConversion}"><CheckBox Content="Limit size · 64–8192 px" IsChecked="{Binding ArtworkLimitDimensions}" Margin="0,0,0,5" /><TextBox Text="{Binding ArtworkMaximumDimension}" /></StackPanel>
                                    <Button Grid.Column="3" Content="Analyze" Command="{Binding AnalyzeArtworkCommand}" VerticalAlignment="Bottom" Margin="14,0,0,0" />
                                </Grid>
                                <Border Style="{StaticResource InfoBox}" Margin="0,18,0,0"><TextBlock Text="{Binding ArtworkEstimate}" TextWrapping="Wrap" /></Border>
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Destination" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding ArtworkOutputFolder}" /></StackPanel>
                                    <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseArtworkOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Text="Leave blank to create an 'artwork' folder beside the source. Identical images are skipped; other name collisions get _2, _3, and so on." Margin="2,8,0,0" />
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Cover preview" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding ArtworkAlbums}" SelectedItem="{Binding SelectedArtworkAlbum}" DisplayMemberPath="OutputBaseName" AutomationProperties.Name="Album" />
                                    <Button Grid.Column="1" Content="Preview cover" Command="{Binding PreviewArtworkCommand}" Margin="8,0" />
                                    <Button Grid.Column="2" Content="Open output folder" Command="{Binding OpenArtworkFolderCommand}" />
                                </Grid>
                                <Image Source="{Binding ArtworkPreview}" Height="180" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding ArtworkPreviewInfo}" Margin="0,8,0,0" />
                                <Separator Style="{StaticResource Rule}" />

                                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Save report" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="Report" Margin="0" VerticalAlignment="Center" /></DockPanel>
                                <ContentControl Content="{Binding ArtworkReport}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Style="{StaticResource PageHost}" Visibility="{Binding IsAboutPage, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="About" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Local audio tools for Windows." />
                        <Border Style="{StaticResource Card}" Padding="32">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Image Source="Assets/audio-converter-logo.png" Width="52" Height="52" Margin="0,0,18,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CodecTone" FontSize="32" FontWeight="Bold" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="4" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="Local processing" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" /></Border>
                                            <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="4" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="No telemetry" FontSize="12" FontWeight="SemiBold" /></Border>
                                            <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="4" Padding="10,5"><TextBlock Text="Windows" FontSize="12" FontWeight="SemiBold" /></Border>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Caption}" Text="Version" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ProductVersion}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Separator Style="{StaticResource Rule}" Margin="0,28" />
                                <TextBlock Style="{StaticResource SectionLabel}" Text="What CodecTone does" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,28,22"><TextBlock Text="Convert" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Move between MP3, FLAC, WAV, OGG, AAC and M4A with explicit quality controls." Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                                    <StackPanel Margin="0,0,28,22"><TextBlock Text="Cut" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Select an exact waveform range, add fades and preview the result before export." Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                                    <StackPanel Margin="0,0,0,22"><TextBlock Text="Compress" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Reduce file size with quality profiles, target budgets and recursive folder processing." Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                                    <StackPanel Margin="0,0,28,0"><TextBlock Text="Artwork" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Extract one embedded front cover per album in its original format or as PNG, JPEG or WebP." Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                                    <StackPanel Margin="0,0,28,0"><TextBlock Text="Remix" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Build an effect rack, preview twenty seconds, edit metadata and export one transformed song." Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                                </UniformGrid>

                                <Separator Style="{StaticResource Rule}" Margin="0,28" />
                                <TextBlock Style="{StaticResource SectionLabel}" Text="How it works" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,22,0"><TextBlock Text="01" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" /><TextBlock Text="Select" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Style="{StaticResource Caption}" Text="Choose or drop a file or folder." Margin="0,4,0,0" /></StackPanel>
                                    <StackPanel Margin="0,0,22,0"><TextBlock Text="02" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" /><TextBlock Text="Validate" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Style="{StaticResource Caption}" Text="ffprobe checks streams and metadata." Margin="0,4,0,0" /></StackPanel>
                                    <StackPanel Margin="0,0,22,0"><TextBlock Text="03" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" /><TextBlock Text="Process" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Style="{StaticResource Caption}" Text="FFmpeg works locally on your PC." Margin="0,4,0,0" /></StackPanel>
                                    <StackPanel><TextBlock Text="04" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" /><TextBlock Text="Write" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Style="{StaticResource Caption}" Text="CodecTone saves the result you chose." Margin="0,4,0,0" /></StackPanel>
                                </UniformGrid>

                                <Separator Style="{StaticResource Rule}" Margin="0,28" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource SectionLabel}" Text="Privacy" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="Your media stays on this computer. CodecTone has no cloud storage, analytics or telemetry. Network access occurs only when you request FFmpeg installation or open GitHub." TextWrapping="Wrap" LineHeight="20" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource SectionLabel}" Text="Built with" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text=".NET 8 · WPF · FFmpeg" FontSize="17" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" Text="Created by inerthel · MIT License" Margin="0,6,0,0" /></StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource Caption}" Text="Diagnostics are stored locally (about 1 MiB maximum). Reports may include file paths. Nothing is uploaded." Margin="0,24,0,10" />
                                <WrapPanel>
                                    <Button Content="Open local diagnostics" Command="{Binding OpenDiagnosticsCommand}" Margin="0,0,8,0" />
                                    <Button Content="View on GitHub" Command="{Binding OpenGitHubCommand}" AutomationProperties.Name="Open the inerthel GitHub profile" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Style="{StaticResource PageHost}" Visibility="{Binding IsRemixPage, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Remix" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Shape one song with presets or your own effect rack, then export it with new metadata." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="Source" />
                                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding RemixSourcePath, Converter={StaticResource EmptyToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DropGlyph}" />
                                        <TextBlock Style="{StaticResource DropTitle}" Text="Drop one song here" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Remix works on one file at a time." HorizontalAlignment="Center" />
                                        <Button Content="Choose file" Command="{Binding ChooseRemixFileCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                    </StackPanel>
                                </ContentControl>
                                <Border Style="{StaticResource FileCard}" Visibility="{Binding RemixSourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FileGlyph}" Text="{StaticResource GlyphAudio}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding RemixSourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding RemixSourceDetails}" /></StackPanel>
                                        <Button Grid.Column="2" Content="Change file" Command="{Binding ChooseRemixFileCommand}" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                                <Separator Style="{StaticResource Rule}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="Preview window · 20 seconds" />
                                <controls:WaveformControl Peaks="{Binding RemixWaveformPeaks}" Duration="{Binding RemixDurationSeconds}" Start="{Binding RemixPreviewStartSeconds}" End="{Binding RemixPreviewEndSeconds}" Playhead="{Binding RemixPlayheadSeconds}" Height="190" AutomationProperties.Name="Remix preview window" />
                                <DockPanel Margin="0,10,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="Applies on the next playback. Does not affect exports.">
                                        <TextBlock Style="{StaticResource Caption}" Text="Volume" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Slider Minimum="0" Maximum="100" Value="{Binding PreviewVolume}" Width="110" VerticalAlignment="Center" AutomationProperties.Name="Preview volume" />
                                        <TextBlock Text="{Binding PreviewVolume, StringFormat={}{0:0}%}" Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Style="{StaticResource TransportButton}" Command="{Binding PreviewOriginalCommand}" AutomationProperties.Name="Play original"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphPlay}" FontSize="12" Margin="0,0,8,0" /><TextBlock Text="Original" /></StackPanel></Button>
                                        <Button Style="{StaticResource TransportButton}" Command="{Binding PreviewRemixCommand}" AutomationProperties.Name="Play remix"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphPlay}" FontSize="12" Margin="0,0,8,0" /><TextBlock Text="Remix" /></StackPanel></Button>
                                        <Button Style="{StaticResource TransportButton}" Command="{Binding StopRemixCommand}" AutomationProperties.Name="Stop preview"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphStop}" FontSize="12" Margin="0,0,8,0" /><TextBlock Text="Stop" /></StackPanel></Button>
                                    </WrapPanel>
                                </DockPanel>
                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Preview starts at" Margin="0,0,0,7" /><TextBox Text="{Binding RemixPreviewStartSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Estimated remix length" Margin="0,0,0,7" /><TextBlock Text="{Binding RemixOutputDuration, Converter={StaticResource TimestampConverter}}" FontSize="16" FontWeight="SemiBold" Padding="0,8" /></StackPanel>
                                </Grid>
                                <Separator Style="{StaticResource Rule}" />

                                <DockPanel Margin="0,0,0,12">
                                    <ListBox DockPanel.Dock="Right" Style="{StaticResource SegmentedList}" ItemsSource="{Binding RemixIntensities}" SelectedItem="{Binding SelectedRemixIntensity}" VerticalAlignment="Center" AutomationProperties.Name="Preset intensity" />
                                    <Border DockPanel.Dock="Right" Style="{StaticResource InfoBox}" Padding="8,4" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding RemixAdaptiveLabel}" Foreground="{DynamicResource MutedTextBrush}" FontWeight="Bold" FontSize="11" /></Border>
                                    <StackPanel><TextBlock Style="{StaticResource SectionLabel}" Text="Presets" Margin="0" /><TextBlock Style="{StaticResource Caption}" Text="Pick a category, then a preset. Intensity scales every preset." Margin="0,4,0,0" /></StackPanel>
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Content="Speed &amp; pitch" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="SpeedPitch" Tag="{Binding SpeedPitchCategoryState}" Style="{StaticResource TabButton}" Margin="0,0,8,8" />
                                    <Button Content="Bass &amp; punch" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="BassPunch" Tag="{Binding BassPunchCategoryState}" Style="{StaticResource TabButton}" Margin="0,0,8,8" />
                                    <Button Content="Atmosphere" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="Atmosphere" Tag="{Binding AtmosphereCategoryState}" Style="{StaticResource TabButton}" Margin="0,0,8,8" />
                                    <Button Content="Vocal &amp; clarity" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="VocalClarity" Tag="{Binding VocalClarityCategoryState}" Style="{StaticResource TabButton}" Margin="0,0,8,8" />
                                    <Button Content="Color &amp; texture" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="ColorTexture" Tag="{Binding ColorTextureCategoryState}" Style="{StaticResource TabButton}" Margin="0,0,8,8" />
                                    <Button Content="Mastering" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="Mastering" Tag="{Binding MasteringCategoryState}" Style="{StaticResource TabButton}" Margin="0,0,8,8" />
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding FilteredRemixPresets}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource PresetCard}" Command="{Binding DataContext.ApplyRemixPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Description}"><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" FontWeight="Normal" Margin="0,4,0,0" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Reset rack" Command="{Binding ResetRemixRackCommand}" HorizontalAlignment="Left" Padding="14,7" Margin="0,4,0,12" />
                                <Border Style="{StaticResource InfoBox}" Margin="0,0,0,18">
                                    <StackPanel><TextBlock Text="{Binding RemixAnalysisStatus}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Style="{StaticResource Caption}" Text="{Binding RemixAdaptiveExplanation}" Margin="0,5,0,0" /></StackPanel>
                                </Border>
                                <Border Visibility="{Binding IsExtremeAudioActive, Converter={StaticResource BooleanToVisibility}}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="13,10" Margin="0,0,0,18">
                                    <StackPanel><TextBlock Text="HEARING WARNING" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" /><TextBlock Text="EARRAPE produces extreme distortion and loudness. Lower your headphones or speakers before Preview or Export. High-volume listening can permanently damage hearing." Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="Effect rack" Margin="0" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding RemixEffectKinds}" SelectedItem="{Binding SelectedRemixEffectKind}" AutomationProperties.Name="Effect to add" />
                                            <Button Grid.Column="2" Content="Add" Command="{Binding AddRemixEffectCommand}" Margin="8,0,0,0" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding RemixEffects}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="{StaticResource GlyphUp}" ToolTip="Move up" AutomationProperties.Name="Move up" Command="{Binding DataContext.MoveRemixEffectUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="{StaticResource GlyphDown}" ToolTip="Move down" AutomationProperties.Name="Move down" Command="{Binding DataContext.MoveRemixEffectDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="{StaticResource GlyphRemove}" ToolTip="Remove effect" AutomationProperties.Name="Remove effect" Command="{Binding DataContext.RemoveRemixEffectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            </Grid>
                                                            <StackPanel Margin="0,6,0,0">
                                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding FirstLabel}" Margin="0,4,0,2" />
                                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><Slider Minimum="{Binding FirstMinimum}" Maximum="{Binding FirstMaximum}" SmallChange="{Binding FirstStep}" TickFrequency="{Binding FirstStep}" IsSnapToTickEnabled="True" Value="{Binding First}" VerticalAlignment="Center" AutomationProperties.Name="{Binding FirstLabel}" /><TextBox Grid.Column="1" Text="{Binding First, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Margin="10,0,0,0" Padding="8,5" /></Grid>
                                                                <StackPanel Visibility="{Binding HasSecond, Converter={StaticResource BooleanToVisibility}}">
                                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding SecondLabel}" Margin="0,8,0,2" />
                                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><Slider Minimum="{Binding SecondMinimum}" Maximum="{Binding SecondMaximum}" SmallChange="{Binding SecondStep}" TickFrequency="{Binding SecondStep}" IsSnapToTickEnabled="True" Value="{Binding Second}" VerticalAlignment="Center" AutomationProperties.Name="{Binding SecondLabel}" /><TextBox Grid.Column="1" Text="{Binding Second, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Margin="10,0,0,0" Padding="8,5" /></Grid>
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding HasThird, Converter={StaticResource BooleanToVisibility}}">
                                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ThirdLabel}" Margin="0,8,0,2" />
                                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions><Slider Minimum="{Binding ThirdMinimum}" Maximum="{Binding ThirdMaximum}" SmallChange="{Binding ThirdStep}" TickFrequency="{Binding ThirdStep}" IsSnapToTickEnabled="True" Value="{Binding Third}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ThirdLabel}" /><TextBox Grid.Column="1" Text="{Binding Third, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" Margin="10,0,0,0" Padding="8,5" /></Grid>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Caption}" Text="Add a preset or effect to begin. Normalize must follow gain effects; fades stay last." Margin="2,4,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <StackPanel>
                                            <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{StaticResource InspectorTabs}" SelectedItem="{Binding RemixInspectorTab}" Margin="0,0,0,14" AutomationProperties.Name="Remix inspector" />

                                            <StackPanel Visibility="{Binding IsRemixExportTab, Converter={StaticResource BooleanToVisibility}}">
                                                <TextBlock Text="Output format" /><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding RemixFormat}" ItemTemplate="{StaticResource FormatItem}" Margin="0,6,0,12" />
                                                <StackPanel Visibility="{Binding IsRemixLossy, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Audio quality" /><ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding RemixBitrate}" Margin="0,6,0,12" /></StackPanel>
                                                <StackPanel Visibility="{Binding IsRemixLossless, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Sample rate" /><ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding RemixSampleRateOption}" Margin="0,6,0,12" /><TextBlock Text="Bit depth" /><ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding RemixBitDepth}" Margin="0,6,0,12" /></StackPanel>
                                                <TextBlock Text="Output folder" /><Grid Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding RemixOutputFolder}" /><Button Grid.Column="1" Content="Browse" Command="{Binding ChooseRemixOutputCommand}" Margin="6,0,0,0" Padding="12,8" /></Grid>
                                                <TextBlock Text="File suffix" /><TextBox Text="{Binding RemixSuffix}" Margin="0,6,0,12" />
                                                <CheckBox Content="Overwrite existing file" IsChecked="{Binding RemixOverwrite}" />
                                                <DockPanel Margin="0,16,0,6"><Button DockPanel.Dock="Right" Content="Save report" Command="{Binding SaveReportCommand}" Padding="10,4" /><TextBlock Text="Export report" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
                                                <ContentControl Content="{Binding RemixReport}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding IsRemixMetadataTab, Converter={StaticResource BooleanToVisibility}}">
                                                <UniformGrid Columns="2"><StackPanel Margin="0,0,6,8"><TextBlock Text="Title" /><TextBox Text="{Binding RemixTitle}" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="Artist" /><TextBox Text="{Binding RemixArtist}" Margin="0,4,0,0" /></StackPanel></UniformGrid>
                                                <UniformGrid Columns="2"><StackPanel Margin="0,0,6,8"><TextBlock Text="Album" /><TextBox Text="{Binding RemixAlbum}" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="Album artist" /><TextBox Text="{Binding RemixAlbumArtist}" Margin="0,4,0,0" /></StackPanel></UniformGrid>
                                                <UniformGrid Columns="2"><StackPanel Margin="0,0,6,8"><TextBlock Text="Genre" /><TextBox Text="{Binding RemixGenre}" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="Date" /><TextBox Text="{Binding RemixDate}" Margin="0,4,0,0" /></StackPanel></UniformGrid>
                                                <UniformGrid Columns="2"><StackPanel Margin="0,0,6,8"><TextBlock Text="Track" /><TextBox Text="{Binding RemixTrack}" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="Disc" /><TextBox Text="{Binding RemixDisc}" Margin="0,4,0,0" /></StackPanel></UniformGrid>
                                                <TextBlock Text="Comment" /><TextBox Text="{Binding RemixComment}" AcceptsReturn="True" MinHeight="55" Margin="0,4,0,10" />
                                                <TextBlock Text="Cover art" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding RemixCoverActions}" SelectedItem="{Binding RemixCoverAction}" Margin="0,6,0,6" /><TextBox Text="{Binding RemixCoverPath}" IsReadOnly="True" Margin="0,0,0,6" /><StackPanel Orientation="Horizontal"><Button Content="Replace" Command="{Binding ChooseRemixCoverCommand}" Margin="0,0,6,0" /><Button Content="Remove" Command="{Binding RemoveRemixCoverCommand}" /></StackPanel>
                                                <Grid Margin="0,16,0,8"><TextBlock Text="Custom tags" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="Add tag" Command="{Binding AddMetadataTagCommand}" HorizontalAlignment="Right" Padding="10,5" /></Grid>
                                                <ItemsControl ItemsSource="{Binding RemixCustomTags}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Key}" Margin="0,0,5,0" /><TextBox Grid.Column="1" Text="{Binding Value}" Margin="0,0,5,0" /><Button Grid.Column="2" Style="{StaticResource IconButton}" Content="{StaticResource GlyphRemove}" ToolTip="Remove tag" AutomationProperties.Name="Remove tag" Command="{Binding DataContext.RemoveMetadataTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1" Visibility="{Binding IsToolWorkspace, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                    <Grid Grid.Row="1" Margin="32,14,32,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding TimingText}" Margin="0,3,0,0" />
                            <Button Content="Install FFmpeg" Command="{Binding InstallFfmpegCommand}" Visibility="{Binding FfmpegMissing, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open folder" Command="{Binding OpenOutputFolderCommand}" Visibility="{Binding ShowOpenOutputFolder, Converter={StaticResource BooleanToVisibility}}" Margin="10,0,0,0" />
                        <Grid Grid.Column="4" Style="{StaticResource HiddenWhenBusy}">
                            <Button Content="Convert audio" Command="{Binding ConvertCommand}" Visibility="{Binding IsConvertPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="10,0,0,0" />
                            <Button Content="Cut audio" Command="{Binding CutCommand}" Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="140" Margin="10,0,0,0" />
                            <Button Content="Compress audio" Command="{Binding CompressCommand}" Visibility="{Binding IsCompressionPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="10,0,0,0" />
                            <Button Content="Extract artwork" Command="{Binding ExtractArtworkCommand}" Visibility="{Binding IsArtworkPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="10,0,0,0" />
                            <Button Content="Export remix" Command="{Binding ExportRemixCommand}" Visibility="{Binding IsRemixPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="10,0,0,0" />
                        </Grid>
                        <Button Grid.Column="4" Content="Cancel" Command="{Binding CancelOperationCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" MinWidth="120" Margin="10,0,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False" Style="{StaticResource FadeHost}">
                <Rectangle Fill="{DynamicResource WindowBrush}" Opacity="0.82" />
                <Rectangle Margin="18" RadiusX="12" RadiusY="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="6 4" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DropGlyph}" FontSize="36" />
                    <TextBlock Text="Drop to load" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
