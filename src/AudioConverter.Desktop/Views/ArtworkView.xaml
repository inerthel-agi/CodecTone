<UserControl x:Class="AudioConverter.Desktop.Views.ArtworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AudioConverter.Desktop.Localization"
             xmlns:controls="clr-namespace:AudioConverter.Desktop.Controls">
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T ExtractArtwork}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T SaveOneEmbeddedFrontCoverPer}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Source}" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding ArtworkSourcePath, Converter={StaticResource EmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="{l:T DropAnAudioFileOrA}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T FoldersAreScannedWithTheirSubfolders}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="{l:T ChooseFile}" Command="{Binding ChooseArtworkFileCommand}" Margin="0,0,8,0" /><Button Content="{l:T ChooseFolder}" Command="{Binding ChooseArtworkFolderCommand}" /></StackPanel>
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource FileCard}" Visibility="{Binding ArtworkSourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FileGlyph}" Text="{Binding ArtworkSourcePath, Converter={StaticResource PathPart}, ConverterParameter=Glyph}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding ArtworkSourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding ArtworkSourcePath, Converter={StaticResource PathPart}, ConverterParameter=Parent}" /></StackPanel>
                        <Button Grid.Column="2" Content="{l:T ChangeFile}" Command="{Binding ChooseArtworkFileCommand}" Margin="12,0,8,0" />
                        <Button Grid.Column="3" Content="{l:T ChangeFolder}" Command="{Binding ChooseArtworkFolderCommand}" />
                    </Grid>
                </Border>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T ImageFormat}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T SaveAs}" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding ArtworkOutputFormats}" ItemTemplate="{StaticResource LocalizedItem}" SelectedItem="{Binding ArtworkOutputFormat}" /></StackPanel>
                    <StackPanel Grid.Column="2" IsEnabled="{Binding IsArtworkConversion}"><CheckBox Content="{l:T LimitSize648192Px}" IsChecked="{Binding ArtworkLimitDimensions}" Margin="0,0,0,5" /><TextBox Text="{Binding ArtworkMaximumDimension}" /></StackPanel>
                    <Button Grid.Column="3" Content="{l:T Analyze}" Command="{Binding AnalyzeArtworkCommand}" VerticalAlignment="Bottom" Margin="14,0,0,0" />
                </Grid>
                <Border Style="{StaticResource InfoBox}" Margin="0,18,0,0"><TextBlock Text="{Binding ArtworkEstimate}" TextWrapping="Wrap" /></Border>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Destination}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T OutputFolder}" Margin="0,0,0,7" /><TextBox Text="{Binding ArtworkOutputFolder}" /></StackPanel>
                    <Button Grid.Column="1" Content="{l:T Browse}" Command="{Binding ChooseArtworkOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T LeaveBlankToCreateAnArtwork}" Margin="2,8,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T CoverPreview}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding ArtworkAlbums}" SelectedItem="{Binding SelectedArtworkAlbum}" DisplayMemberPath="OutputBaseName" AutomationProperties.Name="{l:T Album}" />
                    <Button Grid.Column="1" Content="{l:T PreviewCover}" Command="{Binding PreviewArtworkCommand}" Margin="8,0" />
                    <Button Grid.Column="2" Content="{l:T OpenOutputFolder}" Command="{Binding OpenArtworkFolderCommand}" />
                </Grid>
                <Image Source="{Binding ArtworkPreview}" Height="180" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding ArtworkPreviewInfo}" Margin="0,8,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{l:T SaveReport}" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Report}" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>