<Window x:Class="AudioConverter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AudioConverter.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AudioConverter.Desktop.Controls"
        xmlns:converters="clr-namespace:AudioConverter.Desktop.Converters"
        xmlns:vm="clr-namespace:AudioConverter.Desktop.ViewModels"
        xmlns:views="clr-namespace:AudioConverter.Desktop.Views"
        mc:Ignorable="d" Title="CodecTone" Width="1180" Height="820" MinWidth="900" MinHeight="650"
        Icon="Assets/audio-converter-logo.png" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave" Closing="OnClosing">
    <!-- Taskbar button fills while an operation runs and turns red after a failure. -->
    <Window.TaskbarItemInfo><TaskbarItemInfo ProgressValue="{Binding Host.TaskbarProgress, Mode=OneWay}" ProgressState="{Binding Host.TaskbarState, Mode=OneWay}" /></Window.TaskbarItemInfo>
    <Window.Resources>
        <Style x:Key="HiddenWhenBusy" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding Host.IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
        <DataTemplate DataType="{x:Type vm:ConvertViewModel}"><views:ConvertView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CutViewModel}"><views:CutView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompressViewModel}"><views:CompressView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArtworkViewModel}"><views:ArtworkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RemixViewModel}"><views:RemixView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagsViewModel}"><views:TagsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NormalizeViewModel}"><views:NormalizeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InspectViewModel}"><views:InspectView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SplitViewModel}"><views:SplitView /></DataTemplate>
        <DataTemplate x:Key="NavEntry" DataType="{x:Type vm:NavItem}">
            <Button Style="{StaticResource NavButton}" Command="{Binding ShowCommand}" Tag="{Binding State}" AutomationProperties.Name="{Binding Label}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{Binding GlyphKey, Converter={StaticResource ResourceLookup}}" Width="28" /><TextBlock Text="{Binding Label}" /></StackPanel></Button>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource BackdropBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,20,12,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Image Source="Assets/audio-converter-logo.png" Width="28" Height="28" />
                    <TextBlock Text="CodecTone" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <ContentControl Content="{Binding AboutItem}" ContentTemplate="{StaticResource NavEntry}" Focusable="False" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="{Binding ThemeButtonText}" AutomationProperties.HelpText="{Binding ThemeButtonToolTip}" ToolTip="{Binding ThemeButtonToolTip}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphTheme}" Width="28" /><TextBlock Text="{Binding ThemeButtonText}" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ToggleLanguageCommand}" AutomationProperties.Name="{Binding LanguageButtonText}" AutomationProperties.HelpText="{Binding LanguageButtonToolTip}" ToolTip="{Binding LanguageButtonToolTip}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphLanguage}" Width="28" /><TextBlock Text="{Binding LanguageButtonText}" /></StackPanel></Button>
                    <StackPanel Orientation="Horizontal" Margin="10,14,0,0" ToolTip="{l:T MediaNeverLeavesThisComputer}">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphLock}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Width="28" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T LocalNoTelemetry}" />
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource NavEntry}" Focusable="False" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer IsEnabled="{Binding Host.IsWorkspaceEnabled}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <ContentControl Content="{Binding ActivePage}" Margin="32,26,32,28" Focusable="False" />
            </ScrollViewer>

            <Border Grid.Row="1" Visibility="{Binding IsToolWorkspace, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ProgressBar Value="{Binding Host.Progress, Mode=OneWay}" Maximum="100" Visibility="{Binding Host.IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                    <Grid Grid.Row="1" Margin="32,14,32,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Host.Status}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Host.TimingText}" Margin="0,3,0,0" />
                            <Button Content="{l:T InstallFFmpeg}" Command="{Binding Host.InstallFfmpegCommand}" Visibility="{Binding Host.FfmpegMissing, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{l:T OpenFolder}" Command="{Binding OpenOutputFolderCommand}" Visibility="{Binding ShowOpenOutputFolder, Converter={StaticResource BooleanToVisibility}}" Margin="10,0,0,0" />
                        <Grid Grid.Column="2" Style="{StaticResource HiddenWhenBusy}"><Button Content="{Binding ActiveWorkspace.PrimaryLabel}" Command="{Binding ActiveWorkspace.PrimaryCommand}" Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="10,0,0,0" /></Grid>
                        <Button Grid.Column="2" Content="{l:T Cancel}" Command="{Binding Host.CancelOperationCommand}" Visibility="{Binding Host.IsBusy, Converter={StaticResource BooleanToVisibility}}" MinWidth="120" Margin="10,0,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False" Style="{StaticResource FadeHost}">
                <Rectangle Fill="{DynamicResource WindowBrush}" Opacity="0.82" />
                <Rectangle Margin="18" RadiusX="12" RadiusY="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="6 4" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DropGlyph}" FontSize="36" />
                    <TextBlock Text="{l:T DropToLoad}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
