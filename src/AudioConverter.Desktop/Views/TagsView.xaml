<UserControl x:Class="AudioConverter.Desktop.Views.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CellBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!-- The app's ScrollBar style is a fixed-width vertical bar, so this view supplies a horizontal variant for the wide list. -->
        <ControlTemplate x:Key="ScrollThumb" TargetType="Thumb">
            <Border x:Name="Handle" Background="{DynamicResource MutedTextBrush}" CornerRadius="4" Opacity="0.4" />
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="0.7" /></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="0.9" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="VerticalScrollTemplate" TargetType="ScrollBar">
            <Grid Width="12" Background="Transparent">
                <Track x:Name="PART_Track" Margin="2" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinHeight="42" Cursor="Hand" Template="{StaticResource ScrollThumb}" /></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" /></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalScrollTemplate" TargetType="ScrollBar">
            <Grid Height="12" Background="Transparent">
                <Track x:Name="PART_Track" Margin="2" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinWidth="42" Cursor="Hand" Template="{StaticResource ScrollThumb}" /></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False" /></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="Tags" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Edit tags for many files at once and rename files from their tags." />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="Files" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding HasNoRows, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="Drop audio files or folders here" />
                        <TextBlock Style="{StaticResource Caption}" Text="Folders are scanned with their subfolders. Nothing changes until you save." HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="Choose files" Command="{Binding ChooseFilesCommand}" Margin="0,0,8,0" />
                            <Button Content="Choose folder" Command="{Binding ChooseFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource FileCard}" Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="Add files" Command="{Binding ChooseFilesCommand}" Margin="0,0,8,0" />
                            <Button Content="Add folder" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0" />
                            <Button Content="Clear list" Command="{Binding ClearCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EditorSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <StackPanel Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibility}}">
                    <Separator Style="{StaticResource Rule}" />
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Set for all files" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Artist" Margin="0,0,0,7" />
                            <TextBox Text="{Binding BulkArtist, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Artist for all files" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Album" Margin="0,0,0,7" />
                            <TextBox Text="{Binding BulkAlbum, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Album for all files" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Album artist" Margin="0,0,0,7" />
                            <TextBox Text="{Binding BulkAlbumArtist, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Album artist for all files" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="Genre" Margin="0,0,0,7" />
                            <TextBox Text="{Binding BulkGenre, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Genre for all files" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="Date" Margin="0,0,0,7" />
                            <TextBox Text="{Binding BulkDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Date for all files" />
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="4" Content="Apply to all" Command="{Binding ApplyToAllCommand}" VerticalAlignment="Bottom" Margin="0,12,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="Filled fields are copied to every file. Blank fields stay unchanged." Margin="2,8,0,0" />

                    <Separator Style="{StaticResource Rule}" />
                    <TextBlock Style="{StaticResource SectionLabel}" Text="File names" />
                    <CheckBox Content="Rename files from their tags" IsChecked="{Binding RenameFromTags}" HorizontalAlignment="Left" />
                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding RenameFromTags}">
                        <TextBlock Text="Pattern" Margin="0,0,0,7" />
                        <TextBox Text="{Binding RenamePattern, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="File name pattern" />
                        <TextBlock Style="{StaticResource Caption}" Text="Tokens: {title} {artist} {album} {albumartist} {track} {track:00} {disc} {date} {genre}. The folder and extension stay the same." Margin="2,8,0,0" />
                    </StackPanel>

                    <Separator Style="{StaticResource Rule}" />
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Tags" />
                    <!-- One horizontal scroller holds the header and the rows, so the columns stay aligned. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" /><ColumnDefinition Width="170" /><ColumnDefinition Width="146" /><ColumnDefinition Width="126" /><ColumnDefinition Width="126" /><ColumnDefinition Width="126" /><ColumnDefinition Width="62" /><ColumnDefinition Width="56" /><ColumnDefinition Width="86" /><ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="File" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="Title" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="Artist" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="Album" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="5" Style="{StaticResource Caption}" Text="Album artist" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="6" Style="{StaticResource Caption}" Text="Track" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="7" Style="{StaticResource Caption}" Text="Disc" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="8" Style="{StaticResource Caption}" Text="Date" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="9" Style="{StaticResource Caption}" Text="Genre" Margin="8,0,0,0" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}" MaxHeight="420" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" Focusable="False">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" /><ColumnDefinition Width="170" /><ColumnDefinition Width="146" /><ColumnDefinition Width="126" /><ColumnDefinition Width="126" /><ColumnDefinition Width="126" /><ColumnDefinition Width="62" /><ColumnDefinition Width="56" /><ColumnDefinition Width="86" /><ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}" Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibility}}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding SourcePath}">
                                                <TextBlock Style="{StaticResource FileName}" Text="{Binding FileName}" />
                                                <TextBlock Style="{StaticResource FilePath}" Foreground="{DynamicResource AccentBrush}" Text="{Binding PendingName, StringFormat='→ {0}'}" Visibility="{Binding PendingName, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}" />
                                            </StackPanel>
                                            <TextBox Grid.Column="2" Style="{StaticResource CellBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Title" />
                                            <TextBox Grid.Column="3" Style="{StaticResource CellBox}" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Artist" />
                                            <TextBox Grid.Column="4" Style="{StaticResource CellBox}" Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Album" />
                                            <TextBox Grid.Column="5" Style="{StaticResource CellBox}" Text="{Binding AlbumArtist, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Album artist" />
                                            <TextBox Grid.Column="6" Style="{StaticResource CellBox}" Text="{Binding Track, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Track" />
                                            <TextBox Grid.Column="7" Style="{StaticResource CellBox}" Text="{Binding Disc, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Disc" />
                                            <TextBox Grid.Column="8" Style="{StaticResource CellBox}" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Date" />
                                            <TextBox Grid.Column="9" Style="{StaticResource CellBox}" Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Genre" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <Separator Style="{StaticResource Rule}" />
                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Save report" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="Report" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
