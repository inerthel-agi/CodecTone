<UserControl x:Class="AudioConverter.Desktop.Views.NormalizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="Normalize" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Match the loudness of tracks or whole albums to a target such as -14 LUFS." />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="Source" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="Drop an audio file or a folder here" />
                        <TextBlock Style="{StaticResource Caption}" Text="Folders include their subfolders. Analyze reads files without changing them." HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="Choose file" Command="{Binding ChooseFileCommand}" Margin="0,0,8,0" /><Button Content="Choose folder" Command="{Binding ChooseFolderCommand}" /></StackPanel>
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource FileCard}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FileGlyph}" Text="{Binding SourcePath, Converter={StaticResource PathPart}, ConverterParameter=Glyph}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding SourcePath, Converter={StaticResource PathPart}, ConverterParameter=Parent}" /></StackPanel>
                        <Button Grid.Column="2" Content="Change file" Command="{Binding ChooseFileCommand}" Margin="12,0,8,0" />
                        <Button Grid.Column="3" Content="Change folder" Command="{Binding ChooseFolderCommand}" />
                    </Grid>
                </Border>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Loudness target" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Preset" Margin="0,0,0,7" /><ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding TargetPresets}" SelectedItem="{Binding SelectedTargetPreset}" AutomationProperties.Name="Loudness target preset" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Custom · LUFS" Margin="0,0,0,7" /><TextBox Text="{Binding CustomTargetLufs}" AutomationProperties.Name="Custom loudness target" /></StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="True-peak ceiling · dBTP" Margin="0,0,0,7" /><TextBox Text="{Binding TruePeakCeiling}" AutomationProperties.Name="True-peak ceiling" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Mode" Margin="0,0,0,7" /><ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="Normalization mode" /></StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="Per track brings each file to the target. Album applies one gain to every file, so relative levels stay the same." Margin="2,8,0,0" />
                <Border Style="{StaticResource InfoBox}" Margin="0,14,0,0"><TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" /></Border>
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Analyze" Command="{Binding AnalyzeCommand}" Padding="12,5" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Files" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <Border Style="{StaticResource InfoBox}" Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Caption}" Text="File" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="Loudness" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="True peak" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="Gain" TextAlignment="Right" />
                        </Grid>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding Name}" /><TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Loudness}" TextAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding TruePeak}" TextAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Gain}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}" Text="Analyze lists each file's loudness, true peak and planned gain. Nothing is written yet." Visibility="{Binding IsAnalysisEmpty, Converter={StaticResource BooleanToVisibility}}" />
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Destination" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding OutputFolder}" /></StackPanel>
                    <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,16,0" />
                    <StackPanel Grid.Column="2"><TextBlock Text="File suffix · optional" Margin="0,0,0,7" /><TextBox Text="{Binding Suffix}" /></StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="Leave blank to create a 'normalized' folder and keep the source tree." Margin="2,8,0,12" />
                <WrapPanel>
                    <CheckBox Content="Keep metadata and cover art" IsChecked="{Binding KeepMetadata}" Margin="0,4,28,4" />
                    <CheckBox Content="Overwrite existing files" IsChecked="{Binding Overwrite}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Text="Output keeps each file's format. Lossy files are re-encoded at their source bitrate, and lossless files stay lossless." Margin="2,6,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Save report" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="Report" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
