<UserControl x:Class="AudioConverter.Desktop.Views.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="Split album" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Split one long recording into tracks from a cue sheet or from silences." />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="Source" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="Drop one long audio file here" />
                        <TextBlock Style="{StaticResource Caption}" Text="MP3, FLAC, WAV, OGG, AAC or M4A. A cue sheet with the same name beside it is picked up." HorizontalAlignment="Center" TextAlignment="Center" />
                        <Button Content="Choose file" Command="{Binding ChooseSourceCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource FileCard}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FileGlyph}" Text="{StaticResource GlyphAudio}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding SourceDetails}" /></StackPanel>
                        <Button Grid.Column="2" Content="Change file" Command="{Binding ChooseSourceCommand}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Track layout" />
                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding SplitModes}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="Track layout" />
                <Border Style="{StaticResource FileCard}" Margin="0,14,0,0" Visibility="{Binding IsCueMode, Converter={StaticResource BooleanToVisibility}}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FileName}" Text="Cue sheet" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CueStatus}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Choose cue sheet" Command="{Binding ChooseCueCommand}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsSilenceMode, Converter={StaticResource BooleanToVisibility}}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Threshold (dB)" Margin="0,0,0,7" /><TextBox Text="{Binding NoiseDb, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Min. silence (s)" Margin="0,0,0,7" /><TextBox Text="{Binding MinimumSilenceSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Min. track (s)" Margin="0,0,0,7" /><TextBox Text="{Binding MinimumTrackSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    </Grid>
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Detect silences" Command="{Binding DetectSilenceCommand}" Margin="12,0,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Cuts go in the middle of each silence. Pieces shorter than the minimum join their neighbour." VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Tracks" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Album" Margin="0,0,0,7" /><TextBox Text="{Binding Album, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Album artist" Margin="0,0,0,7" /><TextBox Text="{Binding AlbumArtist, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </Grid>
                <Grid Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="#" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="Title" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="Start" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="End" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="Length" />
                </Grid>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number, StringFormat={}{0:00}}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Track title" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding StartSeconds, Converter={StaticResource TimestampConverter}}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding EndSeconds, Converter={StaticResource TimestampConverter}}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding DurationSeconds, Converter={StaticResource TimestampConverter}}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding TrackSummary}" Margin="0,4,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Output" />
                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" ItemTemplate="{StaticResource FormatItem}" AutomationProperties.Name="Output format" />
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                </Grid>
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="File name pattern" Margin="0,0,0,7" />
                    <TextBox Text="{Binding FilePattern, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{}{track:00} is the track number and {title} the title. Characters Windows forbids in file names are removed." Margin="2,7,0,0" />
                </StackPanel>
                <CheckBox Content="Overwrite existing files" IsChecked="{Binding Overwrite}" Margin="0,14,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Save report" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="Report" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
