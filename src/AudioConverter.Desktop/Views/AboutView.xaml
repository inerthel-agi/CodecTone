<UserControl x:Class="AudioConverter.Desktop.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AudioConverter.Desktop.Localization"
             xmlns:controls="clr-namespace:AudioConverter.Desktop.Controls">
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T About}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T LocalAudioToolsForWindows}" />
        <Border Style="{StaticResource Card}" Padding="32">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Source="Assets/audio-converter-logo.png" Width="52" Height="52" Margin="0,0,18,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CodecTone" FontSize="32" FontWeight="Bold" />
                        <WrapPanel Margin="0,10,0,0">
                            <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="4" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{l:T LocalProcessing}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" /></Border>
                            <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="4" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{l:T NoTelemetry}" FontSize="12" FontWeight="SemiBold" /></Border>
                            <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="4" Padding="10,5"><TextBlock Text="{l:T Windows}" FontSize="12" FontWeight="SemiBold" /></Border>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T Version}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ProductVersion}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Separator Style="{StaticResource Rule}" Margin="0,28" />
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T WhatCodecToneDoes}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16" />
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,28,22"><TextBlock Text="{l:T Convert}" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T MoveBetweenMP3FLACWAVOGG}" Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                    <StackPanel Margin="0,0,28,22"><TextBlock Text="{l:T Cut}" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T SelectAnExactWaveformRangeAdd}" Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                    <StackPanel Margin="0,0,28,22"><TextBlock Text="{l:T Compress}" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T ReduceFileSizeWithQualityProfiles}" Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                    <StackPanel Margin="0,0,28,22"><TextBlock Text="{l:T Artwork}" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T ExtractOneEmbeddedFrontCoverPer}" Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                    <StackPanel Margin="0,0,28,22"><TextBlock Text="{l:T Remix}" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T BuildAnEffectRackPreviewTwenty}" Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                    <StackPanel Margin="0,0,28,22"><TextBlock Text="{l:T Normalize}" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T MatchTheLoudnessOfTracksOr}" Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                    <StackPanel Margin="0,0,28,22"><TextBlock Text="{l:T SplitAlbum}" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T SplitOneLongRecordingIntoTracks}" Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                    <StackPanel Margin="0,0,28,22"><TextBlock Text="{l:T Tags}" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T EditTagsForManyFilesAt}" Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                    <StackPanel Margin="0,0,28,22"><TextBlock Text="{l:T Inspect}" FontSize="18" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T SeeAFileSSpectrogramAnd}" Margin="0,6,0,0" LineHeight="20" /></StackPanel>
                </UniformGrid>

                <Separator Style="{StaticResource Rule}" Margin="0,28" />
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T HowItWorks}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16" />
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,22,0"><TextBlock Text="01" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{l:T Select}" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Style="{StaticResource Caption}" Text="{l:T ChooseOrDropAFileOr}" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Margin="0,0,22,0"><TextBlock Text="02" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{l:T Validate}" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Style="{StaticResource Caption}" Text="{l:T FfprobeChecksStreamsAndMetadata}" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Margin="0,0,22,0"><TextBlock Text="03" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{l:T Process}" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Style="{StaticResource Caption}" Text="{l:T FFmpegWorksLocallyOnYourPC}" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel><TextBlock Text="04" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{l:T Write}" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Style="{StaticResource Caption}" Text="{l:T CodecToneSavesTheResultYouChose}" Margin="0,4,0,0" /></StackPanel>
                </UniformGrid>

                <Separator Style="{StaticResource Rule}" Margin="0,28" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Privacy}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="{l:T YourMediaStaysOnThisComputer}" TextWrapping="Wrap" LineHeight="20" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource SectionLabel}" Text="{l:T BuiltWith}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text=".NET 8 · WPF · FFmpeg" FontSize="17" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Caption}" Text="{l:T CreatedByInerthelMITLicense}" Margin="0,6,0,0" /></StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Caption}" Text="{l:T DiagnosticsAreStoredLocallyAbout1}" Margin="0,24,0,10" />
                <WrapPanel>
                    <Button Content="{l:T OpenLocalDiagnostics}" Command="{Binding OpenDiagnosticsCommand}" Margin="0,0,8,0" />
                    <Button Content="{l:T ViewOnGitHub}" Command="{Binding OpenGitHubCommand}" AutomationProperties.Name="{l:T OpenTheInerthelGitHubProfile}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>