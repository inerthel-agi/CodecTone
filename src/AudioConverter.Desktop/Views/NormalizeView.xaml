<UserControl x:Class="AudioConverter.Desktop.Views.NormalizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AudioConverter.Desktop.Localization">
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Normalize}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T MatchTheLoudnessOfTracksOr}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Source}" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="{l:T DropAnAudioFileOrA}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T FoldersIncludeTheirSubfoldersAnalyzeRead}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="{l:T ChooseFile}" Command="{Binding ChooseFileCommand}" Margin="0,0,8,0" /><Button Content="{l:T ChooseFolder}" Command="{Binding ChooseFolderCommand}" /></StackPanel>
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource FileCard}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FileGlyph}" Text="{Binding SourcePath, Converter={StaticResource PathPart}, ConverterParameter=Glyph}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding SourcePath, Converter={StaticResource PathPart}, ConverterParameter=Parent}" /></StackPanel>
                        <Button Grid.Column="2" Content="{l:T ChangeFile}" Command="{Binding ChooseFileCommand}" Margin="12,0,8,0" />
                        <Button Grid.Column="3" Content="{l:T ChangeFolder}" Command="{Binding ChooseFolderCommand}" />
                    </Grid>
                </Border>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T LoudnessTarget}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T Preset}" Margin="0,0,0,7" /><ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding TargetPresets}" SelectedItem="{Binding SelectedTargetPreset}" AutomationProperties.Name="{l:T LoudnessTargetPreset}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{l:T CustomLUFS}" Margin="0,0,0,7" /><TextBox Text="{Binding CustomTargetLufs}" AutomationProperties.Name="{l:T CustomLoudnessTarget}" /></StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T TruePeakCeilingDBTP}" Margin="0,0,0,7" /><TextBox Text="{Binding TruePeakCeiling}" AutomationProperties.Name="{l:T TruePeakCeiling}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{l:T Mode}" Margin="0,0,0,7" /><ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Modes}" ItemTemplate="{StaticResource LocalizedItem}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="{l:T NormalizationMode}" /></StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T PerTrackBringsEachFileTo}" Margin="2,8,0,0" />
                <Border Style="{StaticResource InfoBox}" Margin="0,14,0,0"><TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" /></Border>
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="{l:T Analyze}" Command="{Binding AnalyzeCommand}" Padding="12,5" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Files}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <Border Style="{StaticResource InfoBox}" Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:T File}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{l:T Loudness}" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{l:T TruePeak}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="{l:T Gain}" TextAlignment="Right" />
                        </Grid>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding Name}" /><TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Loudness}" TextAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding TruePeak}" TextAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Gain}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T AnalyzeListsEachFileSLoudness}" Visibility="{Binding IsAnalysisEmpty, Converter={StaticResource BooleanToVisibility}}" />
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Destination}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T OutputFolder}" Margin="0,0,0,7" /><TextBox Text="{Binding OutputFolder}" /></StackPanel>
                    <Button Grid.Column="1" Content="{l:T Browse}" Command="{Binding ChooseOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,16,0" />
                    <StackPanel Grid.Column="2"><TextBlock Text="{l:T FileSuffixOptional}" Margin="0,0,0,7" /><TextBox Text="{Binding Suffix}" /></StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T LeaveBlankToCreateANormalized}" Margin="2,8,0,12" />
                <WrapPanel>
                    <CheckBox Content="{l:T KeepMetadataAndCoverArt}" IsChecked="{Binding KeepMetadata}" Margin="0,4,28,4" />
                    <CheckBox Content="{l:T OverwriteExistingFiles}" IsChecked="{Binding Overwrite}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T OutputKeepsEachFileSFormat}" Margin="2,6,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{l:T SaveReport}" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Report}" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
