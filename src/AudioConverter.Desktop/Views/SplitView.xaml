<UserControl x:Class="AudioConverter.Desktop.Views.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AudioConverter.Desktop.Localization">
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T SplitAlbum}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T SplitOneLongRecordingIntoTracks}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Source}" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="{l:T DropOneLongAudioFileHere}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T MP3FLACWAVOGGAACOr2}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <Button Content="{l:T ChooseFile}" Command="{Binding ChooseSourceCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource FileCard}" Visibility="{Binding SourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FileGlyph}" Text="{StaticResource GlyphAudio}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding SourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding SourceDetails}" /></StackPanel>
                        <Button Grid.Column="2" Content="{l:T ChangeFile}" Command="{Binding ChooseSourceCommand}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T TrackLayout}" />
                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding SplitModes}" ItemTemplate="{StaticResource LocalizedItem}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="{l:T TrackLayout}" />
                <Border Style="{StaticResource FileCard}" Margin="0,14,0,0" Visibility="{Binding IsCueMode, Converter={StaticResource BooleanToVisibility}}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FileName}" Text="{l:T CueSheet}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CueStatus}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{l:T ChooseCueSheet}" Command="{Binding ChooseCueCommand}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsSilenceMode, Converter={StaticResource BooleanToVisibility}}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="{l:T ThresholdDB}" Margin="0,0,0,7" /><TextBox Text="{Binding NoiseDb, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{l:T MinSilenceS}" Margin="0,0,0,7" /><TextBox Text="{Binding MinimumSilenceSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{l:T MinTrackS}" Margin="0,0,0,7" /><TextBox Text="{Binding MinimumTrackSeconds, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    </Grid>
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="{l:T DetectSilences}" Command="{Binding DetectSilenceCommand}" Margin="12,0,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T CutsGoInTheMiddleOf}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Tracks}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{l:T Album}" Margin="0,0,0,7" /><TextBox Text="{Binding Album, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="{l:T AlbumArtist}" Margin="0,0,0,7" /><TextBox Text="{Binding AlbumArtist, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </Grid>
                <Grid Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="#" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{l:T Title}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{l:T Start}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="{l:T End}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="{l:T Length}" />
                </Grid>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number, StringFormat={}{0:00}}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T TrackTitle}" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding StartSeconds, Converter={StaticResource TimestampConverter}}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding EndSeconds, Converter={StaticResource TimestampConverter}}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding DurationSeconds, Converter={StaticResource TimestampConverter}}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding TrackSummary}" Margin="0,4,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Output}" />
                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" ItemTemplate="{StaticResource FormatItem}" AutomationProperties.Name="{l:T OutputFormat}" />
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T OutputFolder}" Margin="0,0,0,7" /><TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Grid.Column="1" Content="{l:T Browse}" Command="{Binding ChooseOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                </Grid>
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="{l:T FileNamePattern}" Margin="0,0,0,7" />
                    <TextBox Text="{Binding FilePattern, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{}{track:00} is the track number and {title} the title. Characters Windows forbids in file names are removed." Margin="2,7,0,0" />
                </StackPanel>
                <CheckBox Content="{l:T OverwriteExistingFiles}" IsChecked="{Binding Overwrite}" Margin="0,14,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{l:T SaveReport}" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Report}" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
