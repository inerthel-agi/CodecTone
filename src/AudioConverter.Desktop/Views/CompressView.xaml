<UserControl x:Class="AudioConverter.Desktop.Views.CompressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AudioConverter.Desktop.Localization"
             xmlns:controls="clr-namespace:AudioConverter.Desktop.Controls">
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Compress}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T ReduceFileSizeWithAQuality}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Source}" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding CompressionSourcePath, Converter={StaticResource EmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="{l:T DropAnAudioFileOrA}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T TheSourceIsAnalyzedAsSoon}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="{l:T ChooseFile}" Command="{Binding ChooseCompressionFileCommand}" Margin="0,0,8,0" /><Button Content="{l:T ChooseFolder}" Command="{Binding ChooseCompressionFolderCommand}" /></StackPanel>
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource FileCard}" Visibility="{Binding CompressionSourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FileGlyph}" Text="{Binding CompressionSourcePath, Converter={StaticResource PathPart}, ConverterParameter=Glyph}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding CompressionSourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding CompressionSourcePath, Converter={StaticResource PathPart}, ConverterParameter=Parent}" /></StackPanel>
                        <Button Grid.Column="2" Content="{l:T ChangeFile}" Command="{Binding ChooseCompressionFileCommand}" Margin="12,0,8,0" />
                        <Button Grid.Column="3" Content="{l:T ChangeFolder}" Command="{Binding ChooseCompressionFolderCommand}" />
                    </Grid>
                </Border>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T CompressTo}" />
                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding CompressionFormats}" SelectedItem="{Binding CompressionFormat}" ItemTemplate="{StaticResource FormatItem}" AutomationProperties.Name="{l:T CompressionFormat}" />
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T CompressionProfile}" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding CompressionProfiles}" ItemTemplate="{StaticResource LocalizedItem}" SelectedItem="{Binding SelectedCompressionProfile}" /></StackPanel>
                    <StackPanel Grid.Column="2" Visibility="{Binding IsTargetSizeCompression, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{l:T TargetTotalSizeMiB}" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionTargetTotalMb}" /></StackPanel>
                    <Button Grid.Column="3" Content="{l:T Analyze}" Command="{Binding AnalyzeCompressionCommand}" VerticalAlignment="Bottom" Margin="14,0,0,0" />
                </Grid>
                <Border Style="{StaticResource InfoBox}" Margin="0,18,0,0"><TextBlock Text="{Binding CompressionEstimate}" TextWrapping="Wrap" /></Border>
                <StackPanel Visibility="{Binding HasPlannedFiles, Converter={StaticResource BooleanToVisibility}}" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Caption}" Text="{l:T SwitchAFileOffToLeave}" Margin="2,0,0,8" />
                    <ItemsControl ItemsSource="{Binding PlannedFiles}" Style="{StaticResource QueueList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource QueueRow}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Included}" IsEnabled="{Binding CanToggle}" Margin="0,0,4,0" AutomationProperties.Name="{Binding Name}" ToolTip="{l:T IncludeThisFile}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource FileName}" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource QueueStatus}" Focusable="False" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Destination}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T OutputFolder}" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionOutputFolder}" /></StackPanel>
                    <Button Grid.Column="1" Content="{l:T Browse}" Command="{Binding ChooseCompressionOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,16,0" />
                    <StackPanel Grid.Column="2"><TextBlock Text="{l:T FileSuffixOptional}" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionSuffix}" /></StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T LeaveBlankToCreateACompressed}" Margin="2,8,0,12" />
                <WrapPanel>
                    <CheckBox Content="{l:T KeepMetadataAndCoverArt}" IsChecked="{Binding CompressionPreserveMetadata}" Margin="0,4,28,4" />
                    <CheckBox Content="{l:T ShrinkLargeCoverArtMax1200}" IsChecked="{Binding CompressionOptimizeArtwork}" Margin="0,4,28,4" />
                    <CheckBox Content="{l:T OverwriteExistingFiles}" IsChecked="{Binding CompressionOverwrite}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T ReEncodingLossyFilesAsksFor}" Margin="2,6,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{l:T SaveReport}" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Report}" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>