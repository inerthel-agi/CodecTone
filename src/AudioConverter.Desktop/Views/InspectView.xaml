<UserControl x:Class="AudioConverter.Desktop.Views.InspectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AudioConverter.Desktop.Localization">
    <UserControl.Resources>
        <DataTemplate x:Key="KeyValueRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Inspect}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T SeeAFileSSpectrogramAnd}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Source}" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding InspectSourcePath, Converter={StaticResource EmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="{l:T DropOneAudioFileHere}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T MP3FLACWAVOGGAACOr}" HorizontalAlignment="Center" />
                        <Button Content="{l:T ChooseFile}" Command="{Binding ChooseInspectFileCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource FileCard}" Visibility="{Binding InspectSourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FileGlyph}" Text="{StaticResource GlyphAudio}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding InspectSourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding InspectSourceDetails}" /></StackPanel>
                        <Button Grid.Column="2" Content="{l:T ChangeFile}" Command="{Binding ChooseInspectFileCommand}" Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <StackPanel Visibility="{Binding InspectSourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                    <Separator Style="{StaticResource Rule}" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Spectrogram}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding AxisLabels}" Height="{Binding SpectrogramHeightPx}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding Top}" /></Style></ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="NoWrap" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Grid.Column="1" Height="{Binding SpectrogramHeightPx}" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" AutomationProperties.Name="{l:T Spectrogram}">
                            <Image Source="{Binding Spectrogram}" Stretch="Fill" />
                        </Border>
                    </Grid>
                    <Grid Margin="62,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" Text="0:00" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{l:T Time}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding DurationLabel}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Style="{StaticResource InfoBox}" Margin="0,16,0,0"><TextBlock Text="{Binding CutoffVerdict}" TextWrapping="Wrap" /></Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Details}" Margin="0,22,0,6" />
                    <ItemsControl ItemsSource="{Binding FileDetails}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Tags}" Margin="0,18,0,6" />
                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:T NoTagsFound}" Margin="0,4,0,0" Visibility="{Binding HasNoTags, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>

                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{l:T SaveReport}" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Report}" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
