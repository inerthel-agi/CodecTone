<UserControl x:Class="AudioConverter.Desktop.Views.CutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:AudioConverter.Desktop.Localization"
             xmlns:controls="clr-namespace:AudioConverter.Desktop.Controls">
    <StackPanel Style="{StaticResource PageHost}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Cut}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T SelectPartOfATrackAdd}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Source}" />
                <ContentControl Style="{StaticResource DropZone}" Visibility="{Binding CutSourcePath, Converter={StaticResource EmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DropGlyph}" />
                        <TextBlock Style="{StaticResource DropTitle}" Text="{l:T DropOneAudioFileHere}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T MP3FLACWAVOGGAACOr}" HorizontalAlignment="Center" />
                        <Button Content="{l:T ChooseFile}" Command="{Binding ChooseCutFileCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource FileCard}" Visibility="{Binding CutSourcePath, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FileGlyph}" Text="{StaticResource GlyphAudio}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Style="{StaticResource FileName}" Text="{Binding CutSourcePath, Converter={StaticResource PathPart}}" /><TextBlock Style="{StaticResource FilePath}" Text="{Binding CutSourceDetails}" /></StackPanel>
                        <Button Grid.Column="2" Content="{l:T ChangeFile}" Command="{Binding ChooseCutFileCommand}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Selection}" />
                <controls:WaveformControl Peaks="{Binding WaveformPeaks}" Duration="{Binding DurationSeconds}" Start="{Binding StartSeconds}" End="{Binding EndSeconds}" Playhead="{Binding CutPlayheadSeconds}" SeekCommand="{Binding Host.SeekPreviewCommand}" Height="240" AutomationProperties.Name="{l:T CutSelectionWaveform}" />
                <DockPanel Margin="0,10,0,16">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Style="{StaticResource TransportButton}" Command="{Binding PreviewCommand}" AutomationProperties.Name="{l:T PreviewCut}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphPlay}" FontSize="12" Margin="0,0,8,0" /><TextBlock Text="{l:T PreviewCut}" /></StackPanel></Button>
                        <Button Style="{StaticResource TransportButton}" Command="{Binding Host.PausePreviewCommand}" Content="{Binding Host.PauseLabel}" />
                        <Button Style="{StaticResource TransportButton}" Command="{Binding StopPreviewCommand}" AutomationProperties.Name="{l:T StopPreview}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{StaticResource GlyphStop}" FontSize="12" Margin="0,0,8,0" /><TextBlock Text="{l:T Stop}" /></StackPanel></Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{l:T DragAHandleOrFocusThe}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </DockPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="{l:T Start}" Margin="0,0,0,7" /><TextBox Text="{Binding StartSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{l:T End}" Margin="0,0,0,7" /><TextBox Text="{Binding EndSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{l:T SelectionLength}" Margin="0,0,0,7" /><TextBlock Text="{Binding SelectionDuration, Converter={StaticResource TimestampConverter}}" FontSize="16" FontWeight="SemiBold" Padding="0,8" /></StackPanel>
                </Grid>
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><CheckBox Content="{l:T FadeIn}" IsChecked="{Binding FadeInEnabled}" /><TextBox Text="{Binding FadeInSeconds}" Margin="0,6,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1"><CheckBox Content="{l:T FadeOut}" IsChecked="{Binding FadeOutEnabled}" /><TextBox Text="{Binding FadeOutSeconds}" Margin="0,6,0,0" /></StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="{l:T FadeDurationInSeconds}" Margin="2,7,0,0" />
                <Separator Style="{StaticResource Rule}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T OutputFormat}" />
                <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Formats}" SelectedItem="{Binding CutFormat}" ItemTemplate="{StaticResource FormatItem}" AutomationProperties.Name="{l:T OutputFormat}" />
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{l:T OutputFolder}" Margin="0,0,0,7" /><TextBox Text="{Binding CutOutputFolder}" /></StackPanel>
                    <Button Grid.Column="1" Content="{l:T Browse}" Command="{Binding ChooseCutOutputCommand}" VerticalAlignment="Bottom" Margin="8,0,16,0" />
                    <StackPanel Grid.Column="2"><TextBlock Text="{l:T FileSuffix}" Margin="0,0,0,7" /><TextBox Text="{Binding CutSuffix}" /></StackPanel>
                </Grid>
                <WrapPanel Margin="0,14,0,0"><CheckBox Content="{l:T KeepMetadataAndCoverArt}" IsChecked="{Binding PreserveMetadata}" Margin="0,4,28,4" /><CheckBox Content="{l:T OverwriteExistingFile}" IsChecked="{Binding Overwrite}" /></WrapPanel>
                <Separator Style="{StaticResource Rule}" />

                <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{l:T SaveReport}" Command="{Binding SaveReportCommand}" Padding="12,5" /><TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Report}" Margin="0" VerticalAlignment="Center" /></DockPanel>
                <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportView}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
